#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
abi=${1:-arm64-v8a}
case "$abi" in arm64-v8a|x86_64) ;; *) echo 'Usage: scripts/package-mobile-local [arm64-v8a|x86_64]' >&2; exit 2 ;; esac
nix develop .#mobile-runtime --command python3 scripts/mobile-runtime/build.py --abi "$abi"
nix develop .#android --command ./scripts/mobile-android package-local --abi "$abi" --out "target/mobile-local/$abi"
